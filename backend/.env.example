# Backend API (Fastify). Set these in Coolify (or in .env.local for development).
DATABASE_URL=postgres://clipcrew_app:PASSWORD@HOST:5432/postgres   # the limited clipcrew_app user, not the superuser
FRONTEND_ORIGIN=https://clipcrew.ignitralabs.com                   # the only website allowed to call the API (comma-separate for more)
COOKIE_DOMAIN=clipcrew.ignitralabs.com                             # lets the login cookie work on both the site and api. subdomain; leave unset in development
NODE_ENV=production                                                # makes the login cookie Secure
PORT=4000
SECRET_KEY=a-long-random-string                                    # encrypts clipper passwords so the super admin can view them; never change it once set
